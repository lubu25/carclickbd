# Copy these variables in Hostinger hPanel → Node.js app → Environment variables
# (Do not upload your real .env file in the zip.)

NODE_ENV=production
# Hostinger provides PORT for the Node.js application. Do not override it.

# Set this on the FRONTEND website's hosting environment (not the backend app).
# Next.js uses it at build time for server requests and its same-origin API proxy.
NEXT_PUBLIC_API_BASE_URL=https://backend.carclickbd.com/api/v1
NEXT_PUBLIC_SITE_URL=https://carclickbd.com
# Google OAuth Client ID (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Pusher (real-time)
PUSHER_APP_ID=
PUSHER_APP_SECRET=
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# EPS payment (server-only)
EPS_MERCHANT_ID=
EPS_STORE_ID=
EPS_USERNAME=
EPS_PASSWORD=
EPS_HASH_KEY=
# false = live EPS gateway; true = sandbox. Set explicitly in frontend hosting variables.
EPS_IS_SANDBOX=false
EPS_IS_ACTIVE=true

# JPCenter auction sheet API (server-only)
JPCENTER_API_CODE=

# Email / SMTP Settings (Hostinger / Custom Domain)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_EMAIL=info@carclickbd.com
SMTP_PASSWORD=YourHostingerEmailPassword
ADMIN_EMAIL=carclickbd@gmail.com

# Skip Husky git hooks during npm install on the server
HUSKY=0
